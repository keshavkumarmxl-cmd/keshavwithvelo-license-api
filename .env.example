NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:8080
DATABASE_PATH=./data/licensing.sqlite

JWT_SECRET=replace-with-a-long-random-secret
LICENSE_HASH_SECRET=replace-with-another-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
DOWNLOAD_API_KEY=replace-with-extension-download-api-key
DOWNLOAD_LINK_SECRET=replace-with-a-third-long-random-secret
DOWNLOAD_LINK_EXPIRY_HOURS=0
MASTER_LICENSE_EMAIL=
MASTER_LICENSE_KEY=

EXTENSION_PRODUCT_ID=keshav-with-velo
EXTENSION_ZIP_PATH=./storage/extensions/keshav-with-velo.zip
LICENSE_EXPIRY_DAYS=0
MAX_FAILED_ACTIVATIONS_PER_HOUR=8
MAX_AUTO_DEVICE_RELINKS=3
# latest-device = valid email+key always activates and moves license to latest device.
# limited = device relink is limited by MAX_AUTO_DEVICE_RELINKS.
LICENSE_DEVICE_POLICY=latest-device

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Keshav With Velo <no-reply@example.com>"

RESEND_API_KEY=
RESEND_FROM="Keshav With Velo <no-reply@example.com>"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional MongoDB backup/fallback store.
# Use MongoDB Atlas URI here. If empty, backend works normally without Mongo backup.
MONGODB_URI=
MONGODB_DB_NAME=keshavwithvelo_licensing_backup
